WHITESPACE = <space> | <tab> | <newline>;

comment = ';' & [^<newline>]&*;

alpha = 'a'..'z' | 'A'..'Z';

digit = '0'..'9';

alpha_num = alpha | digit;

string = '"' & [^"]&* & '"';

var_name = alpha & ( alpha_num | '-' & alpha_num )&* & [?]?;

callee = var_name | call;

argument = callee | string;

call = '(' &? callee#callee argument#arg* &? ')';

expr = call | comment;

@grammar
tblisp = WHITESPACE&* & expr#content+ & WHITESPACE&*;
